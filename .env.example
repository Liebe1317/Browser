# Server-only AI provider credential. Never prefix with VITE_ and never commit a real value.
GEMINI_API_KEY=

# Optional Akram VPN local HTTP CONNECT gateway, backed by a trusted VPN/WireGuard tunnel.
# Legacy key retained for configuration compatibility; the product name is Akram VPN.
# The gateway must bind to loopback and enforce public-only egress/DNS through the tunnel.
AKSA_VPN_PROXY=
