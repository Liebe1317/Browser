# GEMINI_API_KEY: اختياري. مطلوب فقط لمساعد "ليبي" الذكي. بدونه يعمل المتصفح عادياً.
# Server-only AI provider credential. Never prefix with VITE_ and never commit a real value.
GEMINI_API_KEY=""

# HOST: واجهة الشبكة. الافتراضي 127.0.0.1 (هذا الجهاز فقط).
# الخادم وكيل ويب: لا تضبط HOST=0.0.0.0 إلا إن كنت تستضيفه عمداً.
# HOST="127.0.0.1"

# PORT: يُستخدم في وضع production فقط (أو --port / -p). الافتراضي 3000.
# PORT=3000

# Optional Aksa local HTTP CONNECT gateway, backed by a trusted VPN/WireGuard tunnel.
# The gateway must bind to loopback and enforce public-only egress/DNS through the tunnel.
AKSA_VPN_PROXY=
